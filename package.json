{
  "name": "freebee-tools",
  "description": "Fast, focused browser tools for files, data, media, and everyday work.",
  "private": true,
  "license": "MIT",
  "sideEffects": false,
  "type": "module",
  "version": "1.0.0",
  "scripts": {
    "deploy": "pnpm run build && wrangler pages deploy",
    "build": "remix vite:build",
    "dev": "remix vite:dev",
    "dev:local": "remix vite:dev --mode localdev --host 127.0.0.1",
    "test": "vitest --run",
    "test:watch": "vitest",
    "lint": "eslint --cache --cache-location ./node_modules/.cache/eslint app",
    "lint:fix": "pnpm run lint -- --fix && prettier app --write",
    "start": "wrangler pages dev ./build/client --ip 0.0.0.0 --port 5173",
    "typecheck": "tsc",
    "typegen": "wrangler types",
    "preview": "pnpm run build && pnpm run start"
  },
  "engines": {
    "node": ">=22.22.0 <23"
  },
  "dependencies": {
    "@remix-run/cloudflare": "^2.17.2",
    "@remix-run/cloudflare-pages": "^2.17.2",
    "@remix-run/react": "^2.17.2",
    "isbot": "^4.4.0",
    "jszip": "^3.10.1",
    "lucide-react": "^0.485.0",
    "mediabunny": "1.55.6",
    "papaparse": "5.7.0",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "5.7.284",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-qrcode-logo": "^3.0.0",
    "remix-island": "^0.2.0",
    "tesseract.js": "7.0.0",
    "wrangler": "^4.44.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20251011.0",
    "@eslint/js": "^9.31.0",
    "@remix-run/dev": "^2.17.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^10.1.1",
    "eslint-plugin-prettier": "^5.2.6",
    "pnpm": "^9.14.4",
    "prettier": "^3.5.3",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.37.0",
    "vite": "^5.4.11",
    "vite-tsconfig-paths": "^4.3.2",
    "vitest": "^3.2.6"
  },
  "packageManager": "pnpm@9.14.4"
}
